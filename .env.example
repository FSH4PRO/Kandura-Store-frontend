# Base URL of the Kandura Store Laravel API (no trailing slash on the domain,
# but DO keep the /api suffix). Vite only exposes variables prefixed VITE_ to
# client-side code — never put secrets (Stripe secret keys, Firebase private
# credentials, Laravel APP_KEY, Passport secrets) in this file or any VITE_*
# variable, since they ship in the built JS bundle for anyone to read.
VITE_API_URL=https://kandura-store.onrender.com/api
